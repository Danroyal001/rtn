# Copy to .env (never committed). demo.sh writes its own.

# Where the RTN core is. With RTN_CORE_LIB set, the backend loads the core in-process
# (librtn_ffi) and keeps the network in RTN_DATA. Otherwise it calls a running `rtn serve`.
# RTN_CORE_LIB=../core/target/release/librtn_ffi.so
# RTN_DATA=.rtn-data
RTN_CORE_URL=http://127.0.0.1:8700
RTN_ADMIN_TOKEN=

# The operator console's password.
RTN_CONSOLE_PASSWORD=

# Demo only: show sign-in codes on the sign-in page, as if the phone were in front of you.
# RTN_DEMO=1
